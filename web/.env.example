# Supabase Postgres. Use the transaction pooler for runtime and the session
# pooler (or direct connection) for Prisma migrations.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:6543/postgres?sslmode=require"
DIRECT_DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres?sslmode=require"

NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
SUPABASE_SECRET_KEY="sb_secret_..."
NEXT_PUBLIC_SUPABASE_GOOGLE_ENABLED="false"

# Server-only secret used to hash login rate-limit buckets. Generate a long
# random value for production; do not expose it to the browser.
AUTH_RATE_LIMIT_SECRET=""

# Group invitations still use Resend. Authentication emails are sent by the
# SMTP provider configured in Supabase Authentication settings.
RESEND_API_KEY=""
EMAIL_FROM="OIPay <onboarding@resend.dev>"
EMAIL_DELIVERY_MODE="resend"

NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_AUTH_TOKEN=""

# Protects the scheduled account-deletion recovery endpoint (at least 32 characters).
CRON_SECRET=""
