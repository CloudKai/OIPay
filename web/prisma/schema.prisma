generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum GroupRole {
  OWNER
  MEMBER
}

enum MemberStatus {
  ACTIVE
  INVITED
  REMOVED
}

enum InvitationDeliveryStatus {
  PENDING
  SENT
  FAILED
  DISABLED
}

// Retain the auth ID after completion to prevent stale sessions recreating users.
model AccountDeletionJob {
  authUserId    String    @id @db.Uuid
  attempts      Int       @default(0)
  nextAttemptAt DateTime  @default(now())
  completedAt   DateTime?
  createdAt     DateTime  @default(now())

  @@index([completedAt, nextAttemptAt])
}

enum SplitType {
  EQUAL
  EXACT
  PERCENTAGE
  SHARES
}

enum ExpenseCategory {
  GENERAL
  FOOD
  TRANSPORT
  HOUSING
  ENTERTAINMENT
  SHOPPING
  UTILITIES
  HEALTH
  OTHER
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  OTHER
}

enum ActivityType {
  GROUP_CREATED
  GROUP_UPDATED
  GROUP_ARCHIVED
  MEMBER_INVITED
  MEMBER_INVITATION_REVOKED
  MEMBER_JOINED
  MEMBER_REMOVED
  OWNER_TRANSFERRED
  EXPENSE_CREATED
  EXPENSE_UPDATED
  EXPENSE_DELETED
  SETTLEMENT_CREATED
  SETTLEMENT_UPDATED
  SETTLEMENT_DELETED
}

model User {
  id            String        @id @default(cuid())
  authUserId    String?       @unique @db.Uuid
  name          String
  email         String        @unique
  emailVerified Boolean       @default(false)
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  memberships   GroupMember[]

  @@index([email])
}

model AuthRateLimit {
  id            String    @id @default(cuid())
  bucket        String    @unique
  failedCount   Int       @default(0)
  firstFailedAt DateTime  @default(now())
  lastFailedAt  DateTime  @default(now())
  blockedUntil  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([blockedUntil])
  @@index([updatedAt])
}

model Group {
  id          String        @id @default(cuid())
  name        String
  currency    String        @default("USD") @db.VarChar(3)
  archivedAt  DateTime?
  joinTokenHash String?     @unique
  joinEnabled Boolean      @default(false)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  members     GroupMember[]
  expenses    Expense[]
  settlements Settlement[]
  activities  ActivityLog[]

  @@index([archivedAt])
}

model GuestSession {
  id        String        @id @default(cuid())
  tokenHash String        @unique
  createdAt DateTime      @default(now())
  expiresAt DateTime      @default(dbgenerated("(CURRENT_TIMESTAMP + interval '365 days')"))
  members   GroupMember[]

  @@index([expiresAt])
}

model GroupMember {
  id                   String       @id @default(cuid())
  groupId              String
  userId               String?
  displayName          String
  email                String?
  displayNameKey       String?
  guestSessionId       String?
  guestSession         GuestSession? @relation(fields: [guestSessionId], references: [id], onDelete: SetNull)
  guestRecoveryTokenHash String?     @unique
  guestRecoveryExpiresAt DateTime?
  role                 GroupRole    @default(MEMBER)
  status               MemberStatus @default(ACTIVE)
  invitationTokenHash  String?      @unique
  invitationExpiresAt  DateTime?
  invitationSentAt     DateTime?
  invitationDeliveryStatus InvitationDeliveryStatus?
  invitationAcceptedAt DateTime?
  joinedAt             DateTime     @default(now())
  group                Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user                 User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  paidExpenses         Expense[]    @relation("ExpensePaidBy")
  createdExpenses      Expense[]    @relation("ExpenseCreatedBy")
  expenseShares        ExpenseShare[]
  settlementsFrom      Settlement[] @relation("SettlementFrom")
  settlementsTo        Settlement[] @relation("SettlementTo")
  createdSettlements   Settlement[] @relation("SettlementCreatedBy")
  activities           ActivityLog[]

  @@unique([groupId, userId])
  @@unique([groupId, email])
  @@unique([groupId, displayNameKey])
  @@unique([groupId, guestSessionId])
  @@index([guestSessionId])
  @@index([groupId, status])
  @@index([userId])
  @@index([email])
}

model Expense {
  id                String          @id @default(cuid())
  groupId           String
  createdByMemberId String
  paidByMemberId    String
  description       String
  totalMinor        Int
  originalCurrency  String?         @db.VarChar(3)
  originalMinor     Int?
  exchangeRate      String?         @db.VarChar(40)
  exchangeRateDate  DateTime?        @db.Date
  exchangeRateSource String?        @db.VarChar(80)
  splitType         SplitType
  category          ExpenseCategory @default(GENERAL)
  expenseDate       DateTime        @db.Date
  notes             String?
  version           Int             @default(1)
  idempotencyKey    String
  deletedAt         DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  group             Group           @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdByMember   GroupMember     @relation("ExpenseCreatedBy", fields: [createdByMemberId], references: [id], onDelete: Restrict)
  paidByMember      GroupMember     @relation("ExpensePaidBy", fields: [paidByMemberId], references: [id], onDelete: Restrict)
  shares            ExpenseShare[]

  @@unique([groupId, idempotencyKey])
  @@index([groupId, expenseDate])
  @@index([createdByMemberId])
  @@index([paidByMemberId])
  @@index([deletedAt])
}

model ExpenseShare {
  id            String      @id @default(cuid())
  expenseId     String
  memberId      String
  shareMinor    Int
  percentageBps Int?
  weight        Int?
  createdAt     DateTime    @default(now())
  expense       Expense     @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  member        GroupMember @relation(fields: [memberId], references: [id], onDelete: Restrict)

  @@unique([expenseId, memberId])
  @@index([memberId])
}

model Settlement {
  id                String        @id @default(cuid())
  groupId           String
  createdByMemberId String
  fromMemberId      String
  toMemberId        String
  amountMinor       Int
  originalCurrency  String?       @db.VarChar(3)
  originalMinor     Int?
  exchangeRate      String?       @db.VarChar(40)
  exchangeRateDate  DateTime?      @db.Date
  exchangeRateSource String?      @db.VarChar(80)
  method            PaymentMethod @default(OTHER)
  settledAt         DateTime      @db.Date
  notes             String?
  version           Int           @default(1)
  idempotencyKey    String
  deletedAt         DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  group             Group         @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdByMember   GroupMember   @relation("SettlementCreatedBy", fields: [createdByMemberId], references: [id], onDelete: Restrict)
  fromMember        GroupMember   @relation("SettlementFrom", fields: [fromMemberId], references: [id], onDelete: Restrict)
  toMember          GroupMember   @relation("SettlementTo", fields: [toMemberId], references: [id], onDelete: Restrict)

  @@unique([groupId, idempotencyKey])
  @@index([groupId, settledAt])
  @@index([createdByMemberId])
  @@index([fromMemberId])
  @@index([toMemberId])
  @@index([deletedAt])
}

model ActivityLog {
  id            String      @id @default(cuid())
  groupId       String
  actorMemberId String
  type          ActivityType
  message       String
  metadata      Json?
  createdAt     DateTime    @default(now())
  group         Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  actorMember   GroupMember @relation(fields: [actorMemberId], references: [id], onDelete: Restrict)

  @@index([groupId, createdAt])
  @@index([actorMemberId])
}
