# OIPay: keep these legacy database credentials to reuse existing local data.
# Copy values from the repo root .env.example (or set these in your shell)
POSTGRES_DB=splittogether
POSTGRES_USER=splittogether
POSTGRES_PASSWORD=splittogether
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Use "sqlite" for local-only development if Postgres is unavailable.
DB_ENGINE=postgres

DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
